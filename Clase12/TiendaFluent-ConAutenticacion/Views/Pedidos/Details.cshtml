@using TiendaFluent.Entities
@model PedidoDetalleVM
@{
    var p = Model.Pedido;
    ViewData["Title"] = $"Pedido #{p.Numero}";
    var pendiente = p.Total - Model.Pagado;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Pedido #@p.Numero <partial name="_Estado" model="p.Estado" /></h1>
    <a class="btn btn-link" asp-action="Index">Volver</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Cliente</div>
            <a class="fw-semibold" asp-controller="Clientes" asp-action="Details" asp-route-id="@p.ClienteId">@p.Cliente.Nombre</a>
            <div class="text-muted small mt-2">Fecha</div>
            <div>@p.Fecha.ToLocalTime().ToString("g")</div>
        </div></div>
    </div>
    <div class="col-md-8">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small mb-2">Cambiar estado <span>(control de concurrencia con <code>RowVersion</code>)</span></div>
            <form asp-action="CambiarEstado" asp-route-id="@p.Id" method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(p.RowVersion)" />
                <select name="estado" class="form-select w-auto">
                    @foreach (var e in Enum.GetValues<EstadoPedido>())
                    {
                        <option value="@e" selected="@(e == p.Estado)">@e</option>
                    }
                </select>
                <button class="btn btn-outline-primary">Actualizar</button>
            </form>
            <div class="form-text">RowVersion actual: <code>@Convert.ToHexString(p.RowVersion)</code>. Si otra pestaña cambia el pedido antes, este formulario fallará con <code>DbUpdateConcurrencyException</code>.</div>
        </div></div>
    </div>
</div>

<h2 class="h5">Líneas <span class="text-muted small">(DetallesPedido · llave compuesta PedidoId + ProductoId)</span></h2>
<table class="table bg-white">
    <thead class="table-light"><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio unitario</th><th class="text-end">Subtotal <span class="fw-normal text-muted small">(columna calculada)</span></th></tr></thead>
    <tbody>
    @foreach (var d in p.Detalles)
    {
        <tr>
            <td>@d.Producto.Nombre <code class="small">@d.Producto.Sku</code></td>
            <td class="text-end">@d.Cantidad</td>
            <td class="text-end">@d.PrecioUnitario.ToString("C2")</td>
            <td class="text-end">@d.Subtotal.ToString("C2")</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end">@p.Total.ToString("C2")</th></tr></tfoot>
</table>

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2 class="h5 m-0">Pagos <span class="text-muted small">(herencia TPH: tabla Pagos con discriminador TipoPago)</span></h2>
    @if (pendiente > 0)
    {
        <a class="btn btn-sm btn-primary" asp-action="RegistrarPago" asp-route-id="@p.Id">Registrar pago</a>
    }
</div>
@if (Model.Pagos.Count == 0)
{
    <p class="text-muted mt-2">Sin pagos todavía.</p>
}
else
{
    <table class="table table-sm bg-white mt-2">
        <thead class="table-light"><tr><th>Fecha</th><th>Tipo</th><th>Detalle</th><th class="text-end">Monto</th></tr></thead>
        <tbody>
        @foreach (var pago in Model.Pagos)
        {
            <tr>
                <td>@pago.Fecha.ToLocalTime().ToString("g")</td>
                @switch (pago)
                {
                    case PagoTarjeta t:
                        <td><span class="badge text-bg-info">Tarjeta</span></td>
                        <td>@t.Marca terminada en @t.UltimosDigitos</td>
                        break;
                    case PagoTransferencia tr:
                        <td><span class="badge text-bg-dark">Transferencia</span></td>
                        <td>@tr.Banco · ref. @tr.Referencia</td>
                        break;
                }
                <td class="text-end">@pago.Monto.ToString("C2")</td>
            </tr>
        }
        </tbody>
    </table>
}
<p class="small">Pagado: <strong>@Model.Pagado.ToString("C2")</strong> · Pendiente: <strong>@(pendiente > 0 ? pendiente.ToString("C2") : "$0.00")</strong></p>

<hr />
@if (User.IsInRole(Roles.Administrador))
{
    <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('¿Eliminar el pedido #@p.Numero?')">
        <button class="btn btn-outline-danger btn-sm">Eliminar pedido</button>
        <span class="text-muted small ms-2">Las líneas se borran en cascada; si hay pagos, la FK con Restrict lo impide.</span>
    </form>
}
