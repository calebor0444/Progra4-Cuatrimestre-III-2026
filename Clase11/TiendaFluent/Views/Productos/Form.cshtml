@using TiendaFluent.Entities
@model ProductoFormVM
@{
    var nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo producto" : "Editar producto";
    var etiquetas = (List<Etiqueta>)ViewBag.Etiquetas;
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@(nuevo ? "Create" : "Edit")" asp-route-id="@(nuevo ? null : Model.Id)" method="post" class="card card-body" style="max-width:680px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Sku" class="form-label"></label>
            @if (nuevo)
            {
                <input asp-for="Sku" class="form-control text-uppercase" />
            }
            else
            {
                <input asp-for="Sku" class="form-control" readonly />
                <div class="form-text">Llave alterna: no se puede modificar.</div>
            }
            <span asp-validation-for="Sku" class="text-danger small"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Precio" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" type="number" min="0" />
            <span asp-validation-for="Stock" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                <option value="">— Selecciona —</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Etiquetas <span class="text-muted small">(relación muchos a muchos)</span></label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var e in etiquetas)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="EtiquetasSeleccionadas" value="@e.Id" id="et-@e.Id"
                               checked="@Model.EtiquetasSeleccionadas.Contains(e.Id)" />
                        <label class="form-check-label" for="et-@e.Id">@e.Nombre</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-link" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
