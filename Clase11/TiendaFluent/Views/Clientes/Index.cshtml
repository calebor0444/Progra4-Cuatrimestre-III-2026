@using TiendaFluent.Entities
@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
    var verEliminados = (bool)ViewBag.VerEliminados;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Clientes</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a>
</div>
<p class="text-muted small">
    Filtro global <code>HasQueryFilter(c =&gt; !c.Eliminado)</code>: los clientes eliminados no aparecen en ninguna consulta, salvo con <code>IgnoreQueryFilters()</code>.
    @if (verEliminados)
    {
        <a asp-action="Index">Ocultar eliminados</a>
    }
    else
    {
        <a asp-action="Index" asp-route-verEliminados="true">Ver también los eliminados</a>
    }
</p>

<table class="table table-hover bg-white align-middle">
    <thead class="table-light"><tr><th>Nombre</th><th>Correo</th><th>Ciudad</th><th>Teléfono (perfil 1:1)</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr class="@(c.Eliminado ? "table-secondary text-muted" : "")">
            <td class="fw-semibold">
                @if (c.Eliminado) { @c.Nombre <span class="badge text-bg-secondary ms-1">eliminado</span> }
                else { <a asp-action="Details" asp-route-id="@c.Id">@c.Nombre</a> }
            </td>
            <td>@c.Email</td>
            <td>@c.Direccion.Ciudad</td>
            <td>@(c.Perfil?.Telefono ?? "—")</td>
            <td class="text-end text-nowrap">
                @if (c.Eliminado)
                {
                    <form asp-action="Restaurar" asp-route-id="@c.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-success">Restaurar</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar a @c.Nombre? (borrado lógico)')">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
