@model List<CategoriaListaVM>
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Categorías</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva categoría</a>
</div>
<p class="text-muted small">Relación autorreferenciada <code>Categoria.CategoriaPadre</code> con <code>OnDelete(Restrict)</code>: no se puede borrar una categoría con productos o subcategorías.</p>

<table class="table table-hover bg-white align-middle">
    <thead class="table-light"><tr><th>Nombre</th><th>Categoría padre</th><th class="text-end">Productos</th><th class="text-end">Subcategorías</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td class="fw-semibold">@c.Nombre</td>
            <td>@(c.Padre ?? "—")</td>
            <td class="text-end">@c.Productos</td>
            <td class="text-end">@c.Subcategorias</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar la categoría @c.Nombre?')">
                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
