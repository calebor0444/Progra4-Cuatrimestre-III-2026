@model ResumenVM
@{
    ViewData["Title"] = "Inicio";
}

<h1 class="h3 mb-1">Tienda de ejemplo · EF Core Fluent API</h1>
<p class="text-muted mb-4">Proyecto MVC con .NET 10 y EF Core 10 que implementa el modelo de la guía. Toda la base de datos se define en <code>Data/Configurations</code>.</p>

<div class="row g-3 mb-4">
    @{
        var tarjetas = new[]
        {
            ("Productos", Model.Productos.ToString(), "Productos"),
            ("Categorías", Model.Categorias.ToString(), "Categorias"),
            ("Etiquetas", Model.Etiquetas.ToString(), "Etiquetas"),
            ("Clientes", Model.Clientes.ToString(), "Clientes"),
            ("Pedidos", Model.Pedidos.ToString(), "Pedidos"),
            ("Ventas", Model.Ventas.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US")), "Pedidos"),
        };
    }
    @foreach (var (titulo, valor, ctrl) in tarjetas)
    {
        <div class="col-6 col-md-4 col-lg-2">
            <a class="card text-decoration-none h-100" asp-controller="@ctrl" asp-action="Index">
                <div class="card-body">
                    <div class="text-muted small">@titulo</div>
                    <div class="fs-4 fw-semibold text-dark">@valor</div>
                </div>
            </a>
        </div>
    }
</div>

<h2 class="h5">Dónde ver cada concepto de la guía</h2>
<div class="table-responsive">
<table class="table table-sm table-bordered align-middle bg-white">
    <thead class="table-light">
        <tr><th>Pantalla</th><th>Qué probar</th><th>Configuración</th><th>Guía</th></tr>
    </thead>
    <tbody>
        <tr><td><a asp-controller="Productos" asp-action="Index">Productos</a></td><td>Asignar etiquetas (N:N), crear un SKU repetido, borrar un producto vendido</td><td><code>ProductoConfiguration</code></td><td>6.5 · 8.2 · 9.5 · 10</td></tr>
        <tr><td><a asp-controller="Categorias" asp-action="Index">Categorías</a></td><td>Subcategorías; intentar borrar una categoría con productos</td><td><code>CategoriaConfiguration</code></td><td>9.8 · 10 · 13</td></tr>
        <tr><td><a asp-controller="Etiquetas" asp-action="Index">Etiquetas</a></td><td>Crear un nombre repetido; borrar una etiqueta en uso</td><td><code>EtiquetaConfiguration</code></td><td>8.1 · 9.5</td></tr>
        <tr><td><a asp-controller="Clientes" asp-action="Index">Clientes</a></td><td>Dirección (tipo propio), perfil 1:1, borrado lógico y restaurar, fecha de creación sombra</td><td><code>ClienteConfiguration</code></td><td>7.8 · 8.1 · 9.4 · 11 · 14</td></tr>
        <tr><td><a asp-controller="Pedidos" asp-action="Index">Pedidos</a></td><td>Número por secuencia, subtotal calculado, pagos con herencia, cambio de estado con RowVersion, borrar con/sin pagos</td><td><code>PedidoConfiguration</code>, <code>DetallePedidoConfiguration</code>, <code>PagoConfiguration</code></td><td>6.2 · 6.4 · 7.4–7.7 · 10 · 12</td></tr>
    </tbody>
</table>
</div>
