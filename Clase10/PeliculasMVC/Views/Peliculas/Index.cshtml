@model IEnumerable<PeliculasMVC.Models.ViewModels.Peliculas>

@{
    ViewData["Title"] = "Index";
}

<h1>Listado de películas</h1>

<p>
    <a asp-action="Create">Crear nueva pelicula</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sinopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaDeEstreno)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Director)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sinopsis)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaDeEstrenoFormateada)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
